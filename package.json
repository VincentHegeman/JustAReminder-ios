{
  "name": "justareminder-mobile",
  "version": "1.5.0-ios-interface-herstel",
  "private": true,
  "description": "JustAReminder iOS releasevoorbereiding: UI, sessiecontrole en veilige launch-gate; IAP/push vereist server",
  "scripts": {
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "ios:add": "cap add ios",
