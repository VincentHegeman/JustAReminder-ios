    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "check:iosfix": "node scripts/test-ios-fixes.mjs",
    "check:session": "node scripts/test-ios-session.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "check:navigation": "node scripts/test-ios-navigation.mjs",
    "check:all": "npm run check && npm run check:iosfix && npm run check:session && npm run check:navigation && npm run audit:source"
